{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "vue-split-screen": [
        "../src"
      ]
    },
    "types": [
      "vite/client"
    ],
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vite.config.ts",
    "unocss.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
